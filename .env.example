INGEST_API_KEY=zmen-me-na-nahodny-retezec
ADMIN_PASSWORD=zmen-me-na-silne-heslo
ADMIN_COOKIE_SECURE=0
ALERT_DAY_DBA=45
ALERT_NIGHT_DBA=40
ALERT_DAY_START_HOUR=6
ALERT_DAY_END_HOUR=22
TZ=Europe/Prague
# Kompletní smazání cold/minute/weather starších než N dní
RETENTION_DAYS=90
# Deprecated: jen EAV prune během migrace; nahrazeno HOT_RETENTION_HOURS + cold
LIVE_RETENTION_DAYS=7
# Plných 1 Hz v samples_1s; starší → energy average do samples_5s
HOT_RETENTION_HOURS=48
ARCHIVE_INTERVAL_S=5
ARCHIVE_JOB_INTERVAL_S=300
MIGRATE_EAV_ON_STARTUP=1
# VACUUM_AFTER_MIGRATE=0
# Souřadnice měřicího místa (MET Norway — 4 desetinná místa)
LATITUDE=50.0755
LONGITUDE=14.4378
# Doporučeno: identifikace klienta pro api.met.no
YR_USER_AGENT=hlukomer/1.0 (https://example.com; kontakt@example.com)

# OpenSky Network — přelety (vyžaduje LATITUDE/LONGITUDE)
# AIRCRAFT_ENABLED=1
# Max. výška letadla [m] pro uložení markeru (ADS-B; default 1500 ≈ slyšitelný přelet)
AIRCRAFT_MAX_ALTITUDE_M=1500
# Max. vodorovná vzdálenost od měření [km] — větší = víc markerů, méně přesná korelace se slyšitelností
AIRCRAFT_MAX_DISTANCE_KM=8
# Interval pollu OpenSky [s] (min. 15). Anonymně šetřit kredity (≥60); s OPENSKY_* lze 30–60
AIRCRAFT_POLL_INTERVAL_S=60
# AIRCRAFT_GAP_S=180
# AIRCRAFT_RETENTION_DAYS=90
# Doporučeno (4 000 kreditů/den): účet → API client na opensky-network.org
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
