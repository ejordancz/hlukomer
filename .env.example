# =============================================================================
# Hlukoměr — konfigurace prostředí
# Zkopíruj: cp .env.example .env  a uprav hodnoty.
# =============================================================================


# --- Zabezpečení a admin -----------------------------------------------------

# API klíč pro ESP ingest (POST /api/v1/ingest). Musí sedět s klíčem ve firmware.
INGEST_API_KEY=zmen-me-na-nahodny-retezec

# Heslo do admin rozhraní (/admin). Povinné.
ADMIN_PASSWORD=zmen-me-na-silne-heslo

# Secure flag session cookie (1 = jen HTTPS). Pro lokální HTTP nech 0.
ADMIN_COOKIE_SECURE=0

# Volitelně: tajemství pro podpis admin session cookie (default odvozený z hesla).
# ADMIN_SESSION_SECRET=

# Volitelně: životnost admin session v sekundách (default 3600).
# ADMIN_SESSION_TTL=3600


# --- Prahy hluku a čas -------------------------------------------------------

# Prah LAeq [dB] pro denní alert (graf / notifikace).
ALERT_DAY_DBA=45

# Prah LAeq [dB] pro noční alert.
ALERT_NIGHT_DBA=40

# Začátek „dne“ (lokální hodina 0–23); předtím platí noční práh.
ALERT_DAY_START_HOUR=6

# Konec „dne“ (lokální hodina); od této hodiny platí noční práh.
ALERT_DAY_END_HOUR=22

# Časová zóna (IANA) pro den/noc, grafy a retenci.
TZ=Europe/Prague

# Volitelně: po kolika sekundách bez dat je zařízení offline (default 30).
# OFFLINE_GAP_S=30

# Korekce odrazu u fasády/okna [dB] — jen zobrazení na webu (neukládá se do DB).
DISPLAY_WINDOW_CORRECTION_DB=3

# Penalizace za tónovou složku [dB] — jen zobrazení (snížení limitu při detekci tónu).
DISPLAY_TONAL_PENALTY_DB=5

# Prostředí aplikace:
# - když APP_ENV není uvedeno, použije se DEV (tracker se NEvloží)
# - pro produkci nastav explicitně APP_ENV=PROD (tracker se vloží)
# APP_ENV=PROD


# --- Úložiště, retence a archivace -------------------------------------------

# Kompletní smazání cold / minute / weather starších než N dní.
RETENTION_DAYS=90

# Plných 1 Hz v samples_1s; starší se energy-average rollupují do samples_5s.
HOT_RETENTION_HOURS=48

# Interval cold archivace v sekundách (povolené: 5 nebo 10).
ARCHIVE_INTERVAL_S=5

# Jak často (s) běží background job hot→cold rollup.
ARCHIVE_JOB_INTERVAL_S=300

# Adresář SQLite DB v kontejneru (docker-compose nastavuje /data).
# DATA_DIR=/data


# --- Počasí (MET Norway / Yr) ------------------------------------------------

# Zeměpisná šířka měřicího místa (4 desetinná místa). Nutné pro počasí i přelety.
LATITUDE=50.0755

# Zeměpisná délka měřicího místa.
LONGITUDE=14.4378

# User-Agent pro api.met.no (povinná identifikace klienta).
YR_USER_AGENT=hlukomer/1.0 (https://example.com; kontakt@example.com)


# --- Přelety (OpenSky Network) -----------------------------------------------
# Vyžaduje LATITUDE / LONGITUDE. Bez credentials šetřit poll interval (≥60).

# Zapnout sběr přeletů (1/0). Prázdné = auto podle souřadnic.
# AIRCRAFT_ENABLED=1

# Zobrazit přelety na frontendu (0 = skrýt markery a legendu; sběr řídí AIRCRAFT_ENABLED).
AIRCRAFT_SHOW_UI=1

# Max. výška letadla [m] pro uložení markeru (ADS-B; ~1500 ≈ slyšitelný přelet).
AIRCRAFT_MAX_ALTITUDE_M=1500

# Max. vodorovná vzdálenost od měření [km] — větší = víc markerů, méně přesná korelace.
AIRCRAFT_MAX_DISTANCE_KM=8

# Interval pollu OpenSky [s] (min. 15). Anonymně ≥60; s OPENSKY_* lze 30–60.
AIRCRAFT_POLL_INTERVAL_S=60

# Po kolika sekundách bez sightingu ukončit „přelet“ (default 180).
# AIRCRAFT_GAP_S=180

# Retence přeletů ve dnech (prázdné = stejné jako RETENTION_DAYS).
# AIRCRAFT_RETENTION_DAYS=90

# Padding bbox kolem měření [km] pro OpenSky query (default = AIRCRAFT_MAX_DISTANCE_KM).
# AIRCRAFT_BBOX_PADDING_KM=

# OAuth klient OpenSky (doporučeno: 4 000 kreditů/den) — opensky-network.org → API client.
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
